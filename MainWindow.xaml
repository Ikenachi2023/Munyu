<Window x:Class="Munyu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Munyu.Controls"
        Title="Munyu"
        Height="500" Width="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <!-- Hide ScrollViewer Scrollbars while preserving scrolling -->
        <Style x:Key="HiddenScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="0">
        <!-- Main Container: Black background with dynamic CornerRadius -->
        <Border x:Name="MainContainer"
                Background="#000000"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16,0,0,16"
                Padding="6,8,6,8">
            <Grid x:Name="MainContainerGrid">
                <!-- Centered Eyes Overlay: Sleek textless background -->
                <Grid x:Name="CenteredEyesOverlay"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Opacity="0.85"
                      Panel.ZIndex="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Left Eye -->
                        <Grid Width="22" Height="22" Margin="3,0">
                            <Ellipse Width="22" Height="22" Fill="#FFFFFF" Stroke="#3F3F46" StrokeThickness="1"/>
                            <Canvas Width="22" Height="22">
                                <Grid x:Name="LeftPupilGrid" Width="10" Height="10" Canvas.Left="6" Canvas.Top="6">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="LeftPupilTransform"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="10" Height="10" Fill="#09090B"/>
                                    <Ellipse Width="3" Height="3" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"/>
                                </Grid>
                            </Canvas>
                        </Grid>

                        <!-- Right Eye -->
                        <Grid Width="22" Height="22" Margin="3,0">
                            <Ellipse Width="22" Height="22" Fill="#FFFFFF" Stroke="#3F3F46" StrokeThickness="1"/>
                            <Canvas Width="22" Height="22">
                                <Grid x:Name="RightPupilGrid" Width="10" Height="10" Canvas.Left="6" Canvas.Top="6">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RightPupilTransform"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="10" Height="10" Fill="#09090B"/>
                                    <Ellipse Width="3" Height="3" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"/>
                                </Grid>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MainLayoutGrid" Panel.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                        <RowDefinition x:Name="ContentRow" Height="*"/>
                        <RowDefinition x:Name="FooterRow" Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderCol" Width="Auto"/>
                        <ColumnDefinition x:Name="ContentCol" Width="*"/>
                        <ColumnDefinition x:Name="FooterCol" Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header / Grip Bar for Dragging -->
                    <Border x:Name="HeaderGripBar"
                            Grid.Row="0" Grid.Column="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Padding="4,6,4,6"
                            Margin="0,0,0,4"
                            MouseLeftButtonDown="HeaderGripBar_MouseLeftButtonDown">
                        <StackPanel x:Name="HeaderStackPanel" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Drag Handle Pill -->
                            <Border x:Name="DragPill" Width="28" Height="4" CornerRadius="2" Background="#3F3F46" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stock Items Container -->
                    <ScrollViewer x:Name="MainScrollViewer"
                                  Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource HiddenScrollViewer}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  Focusable="False">
                        <WrapPanel x:Name="ItemsWrapPanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
