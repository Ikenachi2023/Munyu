<UserControl x:Class="Munyu.Controls.ItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="76" Height="86" Margin="4"
             ToolTip="{Binding ToolTipText}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    
    <Border x:Name="CardBorder"
            CornerRadius="10"
            Background="#18181B"
            BorderBrush="Transparent"
            BorderThickness="2"
            Padding="6,8,6,6"
            Cursor="Hand"
            Focusable="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#18181B"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#27272A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Icon Display -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ItemIconImage"
                       Source="{Binding IconSource}"
                       Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                
                <!-- Badge for Binder count -->
                <Border x:Name="BinderBadge"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-4,-4" Padding="4,1"
                        CornerRadius="8"
                        Background="#A855F7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="BinderCountText"
                               Text="{Binding ChildCount}"
                               FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>

            <!-- Title / Name -->
            <TextBlock Grid.Row="1"
                       Text="{Binding DisplayName}"
                       Foreground="#D4D4D8"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       MaxHeight="28"
                       Margin="0,4,0,0"/>
        </Grid>
    </Border>
</UserControl>
