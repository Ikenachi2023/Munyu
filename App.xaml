<Application x:Class="Munyu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Dark Theme Colors & Styles -->
        <SolidColorBrush x:Key="BgDark" Color="#0D0D0E" />
        <SolidColorBrush x:Key="BgCard" Color="#18181B" />
        <SolidColorBrush x:Key="BgCardHover" Color="#27272A" />
        <SolidColorBrush x:Key="BgCardSelected" Color="#3F3F46" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
    </Application.Resources>
</Application>
